# Option 1 (recommended): point to an explicit MetaGPT config2.yaml file.
# METAGPT_CONFIG2_PATH=./config/metagpt/config2.min.yaml

# Option 2: provide minimal OpenAI-compatible fields; main.py will generate
# ~/.metagpt/config2.yaml automatically for MetaGPT runs.
METAGPT_API_KEY=sk-your-key
METAGPT_BASE_URL=https://api.openai.com/v1
METAGPT_MODEL=gpt-4o-mini
