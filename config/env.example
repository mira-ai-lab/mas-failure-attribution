# Required: model API key (prefer CAPTAIN_API_KEY)
CAPTAIN_API_KEY=your_api_key_here

# Optional: endpoint/model overrides
# If omitted, CAPTAIN adapter falls back to OPENAI_BASE_URL / OPENAI_MODEL defaults.
CAPTAIN_BASE_URL=https://api.openai.com/v1
CAPTAIN_MODEL=gpt-5
CAPTAIN_TEMPERATURE=0
CAPTAIN_MAX_TURNS=1
# Nested Expert_summoner <-> CaptainAgent turns; keep >=3 (one seek + reflection).
CAPTAIN_NESTED_MAX_TURNS=3
# Max verification re-seeks after the initial seek (1 => at most 2 total seeks).
CAPTAIN_MAX_RESEEKS=1
# Disable OpenAI SDK auto-retry on 429; pair with CAPTAIN_LLM_CALL_DELAY_SEC.
CAPTAIN_MAX_RETRIES=0
# Nested expert tools: none (default/MATH) | duckduckgo | default (Bing, needs BING_API_KEY)
# Keep the same value across all rounds in one RUN_TAG for replay consistency.
CAPTAIN_TOOL_LIB=none
# Seconds to wait before each live Captain LLM call (0 to disable).
CAPTAIN_LLM_CALL_DELAY_SEC=1.5
# Log exact LLM payload (_oai_system_message + messages) before API calls.
# 1 = inject step only (default when enabled); all = every generate_oai_reply call.
# CAPTAIN_LOG_LLM_INPUT=1
# CAPTAIN_LOG_LLM_INPUT_PREVIEW=200

# Plain LLM for attack/diagnose analysis
ANALYSIS_API_KEY=your_api_key_here
ANALYSIS_BASE_URL=https://api.openai.com/v1
ANALYSIS_MODEL=gpt-5
ANALYSIS_TEMPERATURE=0

# Optional fallback aliases (used only if CAPTAIN_* is missing)
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5
